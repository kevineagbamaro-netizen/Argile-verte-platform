{
  "name": "argile-verte",
  "version": "1.0.0",
  "private": true,
  "description": "Projet Fullstack Argile Verte : Spring Boot, React, PostgreSQL",
  "scripts": {
    "dev:frontend": "npm --prefix frontend run dev",
    "build:frontend": "npm --prefix frontend run build",
    "dev:backend": "mvn -f backend/pom.xml spring-boot:run -Dspring-boot.run.profiles=local",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f"
  }
}
